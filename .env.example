# Copy to .env and change for production. Everything below the first block is optional:
# a feature whose settings are empty stays switched off and the app says so politely.

# --- Required -------------------------------------------------------------------------------
POSTGRES_USER=nussnuss
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nussnuss
# Where browsers reach the web app and the API (CORS, passkeys and the web build). Example domains.
WEB_ORIGIN=https://nussnuss.example
PUBLIC_API_URL=https://api.nussnuss.example

# --- Sign in with Apple / Google (account recovery) -------------------------------------------
# Apple: your app's bundle id and, for the web, the Services ID. Google: OAuth client ids.
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=
# Passkeys: the domain people see in the address bar (no scheme), and its origin.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# --- In-app purchases (Plus, Trip Pass, Looks) -------------------------------------------------
# App Store: Apple Root CA - G3 (download from apple.com/certificateauthority) as a PEM path, and the bundle id.
APPLE_ROOT_CA=
APPLE_BUNDLE_ID=
# Google Play: a service account JSON key (or a path to one) with access in Play Console, and the package name.
GOOGLE_PLAY_SERVICE_ACCOUNT=
ANDROID_PACKAGE_NAME=app.nussnuss.nussnuss
# Never in production: lets test builds unlock Plus without a store.
ALLOW_DEV_PURCHASES=false

# --- Push notifications for reminders -----------------------------------------------------------
# Android: a Firebase service account JSON key. iPhone: an APNs auth key (.p8 path), its id, your team id and bundle id.
FCM_SERVICE_ACCOUNT=
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=

# --- App links (invite links open the app when it is installed) ----------------------------------
# Apple team id and bundle id for apple-app-site-association; the SHA-256 of the Android signing certificate.
APPLE_APP_ID=
ANDROID_CERT_SHA256=

# --- Exchange rates ---------------------------------------------------------------------------
# Any JSON endpoint with a "rates" object; {base} is replaced by the currency code. The default needs no key.
RATES_URL=https://open.er-api.com/v6/latest/{base}
