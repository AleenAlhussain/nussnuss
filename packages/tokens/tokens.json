  "glass": {
    "regular": {
      "light": {
        "fill": "#FFFFFF",
        "fillAlpha": 0.72,
        "highlight": "#FFFFFF",
        "highlightAlpha": 0.55,
        "shadow": "#15121F",
        "shadowAlpha": 0.12
      },
      "dark": {
        "fill": "#1A1533",
        "fillAlpha": 0.8,
        "highlight": "#FFFFFF",
        "highlightAlpha": 0.14,
        "shadow": "#000000",
        "shadowAlpha": 0.5
      },
      "blur": 28,
      "saturation": 1.8
    },
    "frosted": {
      "light": {
        "fill": "#FFFFFF",
        "fillAlpha": 0.94
      },
      "dark": {
        "fill": "#1A1533",
        "fillAlpha": 0.96
      },
      "blur": 0,
      "saturation": 1
    },
    "$backdrops": "Text on glass is checked against the solid fills that can scroll under a bar (cards, buttons, chips). Body text is excluded: after a 28-point blur, a line of text averages to the surface it sits on.",
    "backdrops": {
      "light": [
        "bg",
        "surface",
        "accent",
        "highlight",
        "success",
        "danger"
      ],
      "dark": [
        "bg",
        "surface",
        "accent",
        "highlight",
        "success",
        "danger"
      ]
    },
    "onGlass": [
      "text",
      "text2"
    ],
    "$onGlass": "Only these colors sit directly on glass. Accent-colored controls on a bar are filled capsules (accent fill + onAccent), never accent text on glass."
  },
  "type": {
