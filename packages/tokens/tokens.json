  "font": {
    "web": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Inter\", system-ui, \"Segoe UI\", Roboto, sans-serif",
    "webArabic": "\"SF Arabic\", \"IBM Plex Sans Arabic\", \"Noto Sans Arabic\", system-ui, sans-serif",
    "webRounded": "ui-rounded, \"SF Pro Rounded\", -apple-system, system-ui, sans-serif",
    "display": "Readex Pro",
    "$display": "Amounts and big titles use Readex Pro (Latin and Arabic in one family, OFL). Body text stays the system font so Dynamic Type keeps working.",
    "displayFor": [
      "largeTitle",
      "title1",
      "title2",
      "amountHero"
    ]
  },
  "space": {
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 20,
    "xl": 24,
    "xxl": 32,
    "touch": 44,
    "margin": 20,
    "marginWide": 32
  },
  "radius": {
    "sheet": 34,
    "card": 22,
    "row": 14,
    "control": 12,
    "pill": 999
  },
  "motion": {
    "$note": "Springs follow SwiftUI's response / damping. Web (Motion) uses duration + bounce = 1 - damping. Reduce Motion replaces every spring with the fade.",
    "standard": {
      "response": 0.35,
      "damping": 0.86
    },
    "bouncy": {
      "response": 0.45,
      "damping": 0.7
    },
    "gentle": {
      "response": 0.45,
      "damping": 1.0
    },
    "fadeMs": 150,
    "$press": "Pressed solid buttons scale to 0.97; pressed glass controls swell to 1.04 and brighten. Everything settles with the standard spring and stays under 500 ms.",
    "pressScale": 0.97,
    "glassPressScale": 1.04,
    "$limit": "Every spring settles within 500 ms (the plan's limit): standard 350 ms, bouncy and gentle 450 ms.",
    "sheet": {
      "response": 0.4,
      "damping": 0.88
    }
  },
  "layout": {
    "maxContent": 640,
    "sidebar": 280,
    "tabBar": 64,
    "topBar": 52
  },
