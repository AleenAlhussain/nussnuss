      "focus": "#9B8BFF"
    }
  },
  "glass": {
    "$variants": "Three levels people can pick in Settings, like the clear-to-tinted slider Apple added at WWDC 2026: Clear (regular), Tinted (the default) and Solid (frosted). Reduce Transparency and Increase Contrast always give Solid.",
    "regular": {
      "light": {
        "fill": "#FFFFFF",
        "fillAlpha": 0.72,
        "highlight": "#FFFFFF",
        "highlightAlpha": 0.55,
        "shadow": "#15121F",
        "shadowAlpha": 0.12
      },
      "dark": {
        "fill": "#1A1533",
        "fillAlpha": 0.8,
        "highlight": "#FFFFFF",
        "highlightAlpha": 0.14,
        "shadow": "#000000",
        "shadowAlpha": 0.5
      },
      "blur": 28,
      "saturation": 1.8
    },
    "tinted": {
      "$note": "The default. The look's accentSoft at this opacity, so bars and sheets read as NussNuss violet (or Saffron) and never as plain white.",
      "fillRole": "accentSoft",
      "light": {
        "fillAlpha": 0.8,
        "highlight": "#FFFFFF",
        "highlightAlpha": 0.6,
        "shadow": "#15121F",
        "shadowAlpha": 0.12
      },
      "dark": {
        "fillAlpha": 0.88,
        "highlight": "#FFFFFF",
        "highlightAlpha": 0.16,
        "shadow": "#000000",
        "shadowAlpha": 0.5
      },
      "blur": 28,
      "saturation": 1.8
    },
    "frosted": {
      "light": {
        "fill": "#FFFFFF",
        "fillAlpha": 0.94
      },
      "dark": {
        "fill": "#1A1533",
        "fillAlpha": 0.96
      },
      "blur": 0,
      "saturation": 1
    },
    "$edge": "Clear and Tinted glass get a hairline edge (white at `hairline`) that brightens to `top` at the top-left corner, so glass stays separate from what scrolls under it in bright light.",
    "edge": {
      "light": {
        "top": 0.55,
        "hairline": 0.4
      },
      "dark": {
        "top": 0.26,
        "hairline": 0.12
      }
    },
    "$backdrops": "Text on glass is checked against the solid fills that can scroll under a bar (cards, buttons, chips). Body text is excluded: after a 28-point blur, a line of text averages to the surface it sits on.",
    "backdrops": {
      "light": [
        "bg",
        "surface",
        "accent",
        "highlight",
        "success",
        "danger"
      ],
      "dark": [
        "bg",
        "surface",
        "accent",
        "highlight",
        "success",
        "danger"
      ]
    },
    "onGlass": [
      "text",
      "text2"
    ],
    "$onGlass": "Only these colors sit directly on glass. Accent-colored controls on a bar are filled capsules (accent fill + onAccent), never accent text on glass."
  },
