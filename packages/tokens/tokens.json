    "sheet": 34,
    "card": 22,
    "row": 14,
    "control": 12,
    "pill": 999
  },
  "motion": {
    "$note": "Springs follow SwiftUI's response / damping. Web (Motion) uses duration + bounce = 1 - damping. Reduce Motion replaces every spring with the fade.",
    "standard": {
      "response": 0.35,
      "damping": 0.86
    },
    "bouncy": {
      "response": 0.5,
      "damping": 0.7
    },
    "gentle": {
      "response": 0.55,
      "damping": 1.0
    },
    "fadeMs": 150
  },
  "layout": {
    "maxContent": 640,
    "sidebar": 280,
    "tabBar": 64,
    "topBar": 52
